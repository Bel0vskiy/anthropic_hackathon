# The speech-emotion sidecar: audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim.
# CPU-only. No GPU needed for a forward pass over ~20s of audio.
#
# Railway: new service -> build from Dockerfile -> Dockerfile path "Dockerfile.voice".
# Give this service >= 4 GiB RAM (Settings -> Scaling -> Resources): the weights
# alone are ~1.3GB and torch needs headroom on top.
FROM python:3.12-slim

WORKDIR /app

# CPU wheels first (the default pip torch wheel on Linux bundles CUDA and is
# ~2.5GB+), then the small set of API deps.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY voice/requirements-deploy.txt ./
RUN pip install --no-cache-dir -r requirements-deploy.txt

# Cache the ~1.2GB audeering weights into the image during the build so cold
# starts skip the hub download. Needs network at build time (Railway has it).
COPY voice/ ./
RUN python warm.py

EXPOSE 8788
CMD uvicorn app:app --host 0.0.0.0 --port $PORT
